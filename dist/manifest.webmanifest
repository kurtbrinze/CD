{
  "id": "./",
  "name": "Envíos al CD — PANISA",
  "short_name": "Envíos CD",
  "description": "Generador QR Entrega, Comprobador QR, QR Garita, Ingreso Pedidos, Sugerido envío y Correo a CEDI para las entregas al CD de Walmart.",
  "lang": "es",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#f4f6f9",
  "theme_color": "#0d2140",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Generador QR Entrega",
      "url": "./index.html#entregas",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Comprobador QR",
      "url": "./index.html#comprobador",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "QR Garita",
      "url": "./index.html#garita",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Ingreso Pedidos",
      "url": "./index.html#ingreso",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Sugerido envío",
      "url": "./index.html#sugerido",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Correo a CEDI",
      "url": "./index.html#correo",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/vnd.ms-excel.sheet.macroEnabled.12": [
          ".xlsm"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}